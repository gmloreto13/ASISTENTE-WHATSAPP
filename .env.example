# Copia este archivo como .env.local y llena los valores reales.
# NUNCA subas .env.local a git ni pegues estas claves en el chat.

# --- WhatsApp Cloud API (Meta) - Etapa 2 ---
# Palabra secreta que tú inventas; la misma va en el panel de Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# "App secret" de tu app en Meta for Developers (Configuración > Básica)
WHATSAPP_APP_SECRET=
# Token de acceso del panel de WhatsApp (el temporal dura 24 h; luego usa uno permanente)
WHATSAPP_TOKEN=
# "Phone number ID" del número de prueba (panel de WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=

# --- Claude (Anthropic) - Etapa 3 ---
ANTHROPIC_API_KEY=

# --- Supabase - Etapa 3 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para el servidor; nunca la uses en código del navegador
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe - Etapa 6 ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
